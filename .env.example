# --- App Base URL (switch to your https://*.vercel.app domain in Vercel) ---
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173
VITE_EXTENSION_STORE_URL=https://chromewebstore.google.com/


# --- Google OAuth (User Login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:5173/api/auth/google/callback
# Production: https://distrov2-teal.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback


# --- Facebook / Meta OAuth (from Meta for Developers Dashboard) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/api/auth/meta/callback
META_GRAPH_VERSION=v27.0
# Optional: only needed if using Facebook Login for Business Configuration ID
META_CONFIG_ID=


# --- Session & OAuth Token Encryption (generate random 32+ char hex strings) ---
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Turso Cloud Database (PC, Android & iPhone shared sync) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Chrome Extension Bridge & Vercel Cron Scheduler Security ---
EXTENSION_SYNC_SECRET=
CRON_SECRET=
