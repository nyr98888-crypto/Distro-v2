# --- App Base URL (REQUIRED on Vercel — production origin) ---
VITE_APP_URL=https://distrov2-teal.vercel.app
APP_URL=https://distrov2-teal.vercel.app
VITE_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/oogolchahhanackcmgicnnokaaehmkaj
# Optional override (defaults to store ID oogolchahhanackcmgicnnokaaehmkaj)
VITE_EXTENSION_ID=oogolchahhanackcmgicnnokaaehmkaj


# --- Google OAuth (sole account login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match APP_URL host in production:
GOOGLE_REDIRECT_URI=https://distrov2-teal.vercel.app/api/auth/google/callback


# --- Session & encryption (REQUIRED — 32+ chars) ---
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Turso (optional locally) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Extension / cron ---
EXTENSION_SYNC_SECRET=
CRON_SECRET=
